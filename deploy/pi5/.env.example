# Set this to the Pi's reserved LAN IPv4 address (e.g. 192.168.1.50).
# Leaving it blank prevents accidentally deploying without a valid LAN address.
# Note: Speaker firmware requires HTTP on port 8765 over a private RFC1918 IPv4 address.
ADAM_LAN_IP=
ADAM_HOSTNAME=adam.local
ADAM_UID=1000
ADAM_GID=1000
# Optional USB override for compose.usb.yaml: confirm with `ls /dev/ttyACM*` and `getent group dialout`.
ADAM_USB_DEVICE=/dev/ttyACM0
ADAM_DIALOUT_GID=20
