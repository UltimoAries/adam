menu "ADAM hardware"
    config ADAM_BOARD_146
        bool "Waveshare ESP32-S3-Touch-LCD-1.46 (SPD2010 / PCM5101 / digital microphone)"
        default n
        help
            Leave disabled for the original 1.85C BOX V2. These boards use
            different audio wiring and display/touch controllers.
endmenu

menu "ADAM voice capture"
    config ADAM_ENDPOINT_SILENCE_MS
        int "Quiet time before ending a wake command (milliseconds)"
        range 600 1500
        default 750
        help
            Increase to 1200 to restore the previous pause tolerance.
            Capture ends on a complete 20 ms packet.
endmenu
